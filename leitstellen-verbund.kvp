Meta.DisplayName=Leitstellen-Verbund
Meta.Description=Deutschland-Leitstelle mit geprüften Programmupdates
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Philipp284868
Meta.URL=https://github.com/Philipp284868/Leitstellen-Verbund
Meta.DisplayImageSource=none:
Meta.ConfigManifest=leitstellen-verbundconfig.json
Meta.ConfigRoot=leitstellen-verbund.kvp
Meta.MinAMPVersion=2.8.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.ContainerPolicy=Supported
Meta.ConfigVersion=1
Meta.AppConfigId=8b74fdb9-d1c9-42d4-b31c-4e4a86ffca30
Meta.Prerequisites=[]
App.DisplayName=Leitstellen-Verbund
App.RootDir=./leitstellen-instance/
App.BaseDirectory=./leitstellen-instance/
App.ExecutableLinux=node/bin/node
App.WorkingDir=.
App.CommandLineArgs=launcher/runtime.mjs {{Operation}} {{ResetRequest}}
App.EnvironmentVariables={"LV_INSTANCE_ROOT":"{{$FullRootDir}}","PORT":"{{$ServerPort}}","PUBLIC_URL":"{{PublicUrl}}","HOST":"{{$ApplicationIPBinding}}","LV_ADOPT_SOURCE":"{{LegacySource}}"}
App.AppSettings={}
App.ExitMethod=SIGTERM
App.ExitTimeout=45
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=127.0.0.1
App.SupportsIPv6=True
App.Ports=@IncludeJson[leitstellen-verbundports.json]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=0
App.AdminMethod=STDIO
App.MaxUsers=0
App.UseRandomAdminPassword=False
App.UpdateSources=@IncludeJson[leitstellen-verbundupdates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^Spiel bereit: .*$
Console.ThrowawayMessageRegex=
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=0
