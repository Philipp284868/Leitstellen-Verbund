# Betreiberbeispiel: gaminglive.mooo.com durch die eigene Domain ersetzen.
# Eine neue Installation erzeugt .env mit einer sicheren lokalen Adresse.
HOST=127.0.0.1
PORT=7777
PUBLIC_URL=https://gaminglive.mooo.com
ALLOW_HTTP=false
TRUSTED_PROXIES=127.0.0.1,::ffff:127.0.0.1
# DATA_DIR und GEODATA_DIR setzt das Setup auf echte externe Instanzordner.
# Optional: vor dem ersten Setup eigene dauerhafte absolute Pfade eintragen.
# DATA_DIR=
# GEODATA_DIR=
# Optional: ausdrücklich separat verwalteter Router mit passender Importkennung.
# GRAPHHOPPER_URL=http://127.0.0.1:8989
