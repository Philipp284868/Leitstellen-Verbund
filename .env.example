# Copy to .env in the application directory. Never commit the real file.
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
# Absolute persistent directory OUTSIDE the application installation:
DATA_DIR=/srv/leitstellen-data
# Deutschland: separate persistent map package, prepared once with scripts/geodata/pipeline.mjs.
# GEODATA_DIR=/srv/leitstellen-deutschland-geodata
# Set only when managing the matching local routing service yourself:
# GRAPHHOPPER_URL=http://127.0.0.1:8989
# Exact immediate reverse-proxy addresses (as seen by Node); empty trusts none.
TRUSTED_PROXIES=
# Use HTTPS publicly. Explicit HTTP exception only for a private test network:
ALLOW_HTTP=false
