# Betreiberbeispiel: gaminglive.mooo.com durch die eigene Domain ersetzen.
# AMP verwendet shared/config/.env; Port/Adresse/Bind-IP aus AMP haben Vorrang.
HOST=127.0.0.1
PORT=7777
PUBLIC_URL=https://gaminglive.mooo.com
ALLOW_HTTP=false
TRUSTED_PROXIES=127.0.0.1,::ffff:127.0.0.1
# Daten- und Geodatenpfade verwaltet shared/state/instance.json.
# Keine Pfade oder Reset-Schalter bei normalen Updates hinzufügen.
# Optional: ausdrücklich separat verwalteter Router mit passender Importkennung.
# GRAPHHOPPER_URL=http://127.0.0.1:8989

# Optional: Fine-grained GitHub PAT, nur Philipp284868/Leitstellen-Verbund.
# Repository permission: Issues = Read and write. Niemals VITE_ verwenden.
# Ohne Token: Direktversand nicht eingerichtet; Spiel und Export funktionieren.
# GITHUB_ISSUES_TOKEN=
